# Application runtime database. Set this explicitly in the private runtime env.
# This example intentionally does not point to any real database.
DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@127.0.0.1:5543/REPLACE_WITH_DATABASE_SCRATCH

# Explicit local scratch targets for Prisma CLI. Prisma commands never use
# DATABASE_URL. Use distinct *_scratch databases and ports other than 5433.
MIGRATION_DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@127.0.0.1:5543/flowforge_migration_scratch
SHADOW_DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@127.0.0.1:5543/flowforge_shadow_scratch

# Optional integration database. Tests never fall back to DATABASE_URL.
# Use a dedicated scratch database on a port other than 5433.
TEST_DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@127.0.0.1:5543/flowforge_test_scratch

NODE_ENV=development
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000

# Phase 1B API authentication. Generate ACCESS_TOKEN_SECRET from a cryptographic
# random source with at least 32 bytes; never commit a real value.
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_ISSUER=flowforge
ACCESS_TOKEN_AUDIENCE=flowforge-api
ACCESS_TOKEN_LIFETIME_SECONDS=600
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3000

# Required in production for invitation and password-reset delivery. Use a
# provider-issued SMTPS URL and configure the exact public web origin.
SMTP_URL=smtps://USER:PASSWORD@smtp.example.com:465
SMTP_FROM=no-reply@example.com
PUBLIC_APP_URL=https://app.example.com
