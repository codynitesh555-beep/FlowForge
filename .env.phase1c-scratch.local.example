# Copy to .env.phase1c-scratch.local, replace every placeholder, and keep the
# local file private. The .local suffix is ignored by the repository rules.
SCRATCH_POSTGRES_USER=REPLACE_WITH_SCRATCH_USERNAME
SCRATCH_POSTGRES_PASSWORD=REPLACE_WITH_SCRATCH_PASSWORD

# URLs for later Prisma verification. Shadow and test databases are not created
# by this Compose service; provision them separately after explicit approval.
MIGRATION_DATABASE_URL=postgresql://REPLACE_WITH_SCRATCH_USERNAME:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55432/flowforge_migration_scratch
SHADOW_DATABASE_URL=postgresql://REPLACE_WITH_SCRATCH_USERNAME:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55432/flowforge_shadow_scratch
TEST_DATABASE_URL=postgresql://REPLACE_WITH_SCRATCH_USERNAME:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55432/flowforge_test_scratch
