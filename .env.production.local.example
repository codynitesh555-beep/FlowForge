# Copy to .env.production.local only for a deliberately configured deployment.
# Replace every placeholder. Never point this file at the local scratch service.
NODE_ENV=production
DATABASE_URL=postgresql://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@REPLACE_WITH_DATABASE_HOST:5432/REPLACE_WITH_DATABASE
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_ISSUER=flowforge
ACCESS_TOKEN_AUDIENCE=flowforge-api
ACCESS_TOKEN_LIFETIME_SECONDS=600
CORS_ALLOWED_ORIGINS=https://app.example.com
API_HOST=127.0.0.1
API_PORT=3000
SMTP_URL=smtps://REPLACE_WITH_USER:REPLACE_WITH_PASSWORD@smtp.example.com:465
SMTP_FROM=no-reply@example.com
PUBLIC_APP_URL=https://app.example.com
