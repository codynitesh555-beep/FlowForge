{
  "name": "flowforge",
  "version": "1.0.0",
  "description": "FlowForge - Intelligent Engineering Workflow & Resource Allocation Platform",
  "type": "module",
  "scripts": {
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc",
    "build:web": "tsc -p tsconfig.web.json && vite build --config vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "dev:api": "tsx watch src/api/dev-api.ts",
    "start:api": "node scripts/start-api.mjs",
    "dev:web": "vite --config vite.config.ts",
    "test": "vitest run",
    "test:offline": "vitest run --exclude src/infrastructure/database/schema.integration.spec.ts",
    "test:watch": "vitest",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:deploy:production": "prisma migrate deploy --config prisma7.production.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts",
    "db:test:deploy": "prisma migrate deploy --config prisma7.test.config.ts",
    "test:integration": "node --import tsx scripts/test-integration.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  }
}
